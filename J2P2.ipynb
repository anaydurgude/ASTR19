   "source": [
    "r = np.linspace(2,0.2,100)\n",
    "x = np.linspace(0,2*np.pi,100)\n",
    "y = np.random.normal(0,r,100)\n",
    "plt.errorbar(x,y, fmt='*', c=\"pink\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.savefig(\"decreasingdeviation.pdf\")"
   ]
